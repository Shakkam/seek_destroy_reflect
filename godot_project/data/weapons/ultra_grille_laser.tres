[ext_resource type="Script" path="res://simulation/weapon_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ultra_grille_laser"
display_name = "Grille Laser"
; Zoneur's Ultra (2026-08-13 party-mode brainstorm, Epic 4 memlog):
; "grille laser (motif de faisceaux lisible, des trous a trouver)" —
; several fixed-position BeamNodes (freeze_position=true, see
; MatchArenaNode._ultra_grille_laser()) spanning evenly-spaced bands
; across the arena's height, with a couple of bands left as gaps to dodge
; into. damage is per-second (effect_type "beam" convention) — lower per
; band than the base laser.tres's 20/s since several bands can be active
; at once.
damage = 8
effect_type = "beam"
beam_range = 5000.0
