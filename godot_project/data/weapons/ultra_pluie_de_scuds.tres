script = ExtResource("1")
id = "ultra_pluie_de_scuds"
display_name = "Pluie de Scuds"
; Lourd's Ultra (2026-08-13 party-mode brainstorm, Epic 4 memlog):
; "bombardement lourd imprecis" — heavy (bazooka-tier) shells, but
; scattered with real random jitter per shot (see
; MatchArenaNode._ultra_pluie_de_scuds()) rather than the clean,
; deliberate fan every other burst weapon uses — "imprecis" is the point.
