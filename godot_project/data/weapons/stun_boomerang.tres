[resource]
script = ExtResource("1")
id = "stun_boomerang"
display_name = "Boomerang"
damage = 1
fire_rate = 1.0
gauge_max = 100.0
; 2026-08-17 (batch balance testing: Perturbateur at 10-24% win rate
; across every re-test, the worst-performing weapon economy in the
; roster even after the shared AI fire-cadence fix). Camil: "je pense
; que le cout des boomerangs est trop eleve. reduit le de moitie" — was
; 35.0, the priciest non-turret weapon in the kit for a 1-damage,
; 3-projectile burst; halving it lets the AI (and a human) actually
; throw it more than once or twice a match instead of sitting mostly
; empty between ball-return gauge fills.
gauge_cost_per_shot = 17.5
is_heavy = false
effect_type = "damage"
effect_duration = 0.0
is_boomerang = true
; 2026-08-17 (Camil: "les tirs de perturbateur sont petits, je pense
; qu'on peut legerement les grossir"). Was 1.0 (the default — every
; other weapon sets its own effective size via _spawn_projectile()'s
; hardcoded per-weapon visual_scale instead).
visual_scale_multiplier = 1.3
projectile_spin_speed = 720.0
projectile_count = 3
burst_spread_deg = 24.0
burst_stagger = 0.08
boomerang_out_duration = 2.0
charge_fire_duration = 3.0
charge_fire_slow_multiplier = 0.3
charged_projectile_count = 1
charged_boomerang_out_duration = 2.0
charged_damage_multiplier = 5.0
charged_visual_scale_multiplier = 5.0
; 2026-08-16 reward system — beating Perturbateur anywhere unlocks "lors
; de l'ultra du joueur, applique aussi le brouillage, mais uniquement
; 5 sec" — reactive, not periodic: whenever the ship who unlocked this
; triggers ITS OWN Ultra (any character's), the opponent also gets a 5s
; control-scramble stacked on top. No Timer at all, so passive_interval
; is inert here (0, see MatchArenaNode._on_ultra_triggered()).
passive_interval = 0.0
passive_description = "Votre Ultra brouille aussi les commandes adverses, 5s en plus de son effet normal."
