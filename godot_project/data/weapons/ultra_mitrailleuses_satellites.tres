[resource]
script = ExtResource("1")
id = "ultra_mitrailleuses_satellites"
display_name = "Mitrailleuses Satellites"
; Mitrailleur's Ultra (2026-08-13 party-mode brainstorm, Epic 4 memlog):
; "mitrailleuses satellites (double full-auto temporaire)" — reworked
; 2026-08-15 (Camil): the satellites no longer autofire on their own
; (TurretNode.autofire=false) — they fire in sync with the player's own
; normal shots instead (see MatchArenaNode._ultra_mitrailleuses_
; satellites()/_on_satellite_fire()), so fire_rate/damage here are now
; unused (kept for turret_hp/turret_lifetime, still a real destructible
; visual escort). turret_lifetime doubled 2026-08-15 ("x2 sur la duree
; de l'ultra").
damage = 2
fire_rate = 7.0
effect_type = "turret"
turret_hp = 15.0
turret_lifetime = 12.0
